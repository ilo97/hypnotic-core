# ─── Stripe ────────────────────────────────────────────────────────
# Get your keys at https://dashboard.stripe.com/apikeys
# Test mode: sk_test_...   (for development)
# Live mode:  sk_live_...  (for production)
STRIPE_SECRET_KEY=

# Stripe Webhook Secret – get from Stripe Dashboard > Webhooks
# Required for production webhook signature verification
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (optional – if not set, prices are computed from pricing.js)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# ─── Frontend ──────────────────────────────────────────────────────
# The URL of your frontend (for redirects after checkout)
FRONTEND_URL=https://ilo97.github.io/hypnotic-core/

# ─── Server ────────────────────────────────────────────────────────
PORT=3001